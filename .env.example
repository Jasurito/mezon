# Postgres (локально из docker compose на порту 5433)
DATABASE_URL=postgresql+psycopg://adolat:adolat@localhost:5433/adolat
# Ключ Anthropic; пустой = режим без AI
ANTHROPIC_API_KEY=
LLM_MODEL_MENTOR=claude-haiku-5-5
LLM_MODEL_FAST=claude-haiku-5-5
# Провайдер LLM: anthropic (по умолчанию) или ollama (локальная модель, ключ не нужен).
# Чтобы включить Ollama: LLM_PROVIDER=ollama, затем вручную скачать модель: ollama pull gemma3:12b
LLM_PROVIDER=anthropic
OLLAMA_URL=http://localhost:11434
# В docker адрес хоста такой: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_MENTOR_TIMEOUT=60
OLLAMA_FAST_TIMEOUT=15
# Для локальной модели советуем RAG_MAX_SOURCES=4: меньше контекст, быстрее ответ
# Таймауты вызовов в секундах и уровень усилия наставника
LLM_MENTOR_TIMEOUT=20
LLM_FAST_TIMEOUT=4
LLM_MENTOR_EFFORT=medium
# Выбранная модель эмбеддингов (см. docs/INGESTION.md)
EMBEDDER=
# Адреса фронтенда через запятую
CORS_ORIGINS=http://localhost:3000
# Порог релевантности RAG
RAG_MIN_SCORE=0.01
RAG_TOP_K=30
RAG_RRF_K=60
RAG_TITLE_SIMILARITY=0.6
RAG_MAX_SOURCES=8
# Reranker кандидатов поиска: none | llm. llm добавляет один быстрый вызов модели
# (на Haiku около 1 с, на локальной Gemma заметно дольше). RERANK_TIMEOUT пусто = таймаут быстрой модели.
RERANKER=none
RERANK_CANDIDATES=15
RERANK_TIMEOUT=
# Порт бэкенда на хосте (docker compose и make dev)
BACKEND_PORT=8000
