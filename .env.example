# Postgres (локально из docker compose на порту 5433)
DATABASE_URL=postgresql+psycopg://adolat:adolat@localhost:5433/adolat
# MongoDB для истории игрока (локально из docker compose на порту 27018). Пусто = история выключена
MONGO_URL=mongodb://localhost:27018
MONGO_DB=adolat
# Ключ Anthropic; пустой = режим без AI
ANTHROPIC_API_KEY=
LLM_MODEL_MENTOR=claude-haiku-5-5
LLM_MODEL_FAST=claude-haiku-5-5
# Провайдер LLM: anthropic (по умолчанию) или ollama (локальная модель, ключ не нужен).
# Чтобы включить Ollama: LLM_PROVIDER=ollama, затем вручную скачать модель: ollama pull gemma3:12b
LLM_PROVIDER=anthropic
OLLAMA_URL=http://localhost:11434
# В docker адрес хоста такой: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_MENTOR_TIMEOUT=60
OLLAMA_FAST_TIMEOUT=15
# false = отключить режим размышлений (нужно для qwen3); пусто = не передавать
OLLAMA_THINK=
# Для локальной модели советуем RAG_MAX_SOURCES=4: меньше контекст, быстрее ответ
# Таймауты вызовов в секундах и уровень усилия наставника
LLM_MENTOR_TIMEOUT=20
LLM_FAST_TIMEOUT=4
LLM_MENTOR_EFFORT=medium
# Выбранная модель эмбеддингов (см. docs/INGESTION.md). Пусто = dense-ветка выключена.
# ollama-bge-m3 = BGE-M3 через Ollama (OLLAMA_URL), модель скачивается вручную: ollama pull bge-m3
# Пример: EMBEDDER=ollama-bge-m3
EMBEDDER=
# Адреса фронтенда через запятую
CORS_ORIGINS=http://localhost:3000
# Порог релевантности RAG
RAG_MIN_SCORE=0.01
RAG_TOP_K=30
RAG_RRF_K=60
RAG_TITLE_SIMILARITY=0.6
RAG_MAX_SOURCES=8
# Наставник: rules = классификация вопроса правилами без вызова LLM (быстрее), llm = быстрая модель.
# MENTOR_MAX_SOURCES = сколько статей уходит наставнику (RAG_MAX_SOURCES наставника не касается).
MENTOR_CLASSIFIER=rules
MENTOR_MAX_SOURCES=5
# Reranker кандидатов поиска: none | llm. llm добавляет один быстрый вызов модели
# (на Haiku около 1 с, на локальной Gemma заметно дольше). RERANK_TIMEOUT пусто = таймаут быстрой модели.
RERANKER=none
RERANK_CANDIDATES=15
RERANK_TIMEOUT=
# Порт бэкенда на хосте (docker compose и make dev)
BACKEND_PORT=8000

# --- Авторизация (аккаунты, cookie mezon_session)
# Secure у cookie сессии. По умолчанию true (прод, https). Для локальной разработки по http поставь false.
COOKIE_SECURE=false
# Срок серверной сессии в днях
SESSION_TTL_DAYS=30
# Доверять X-Forwarded-For (только если бэкенд стоит за своим nginx и порт напрямую не открыт)
TRUST_PROXY_HEADERS=false
# Ограничение перебора: неудачных входов на email и auth-запросов с одного IP за окно (минуты)
AUTH_LOGIN_MAX_FAILS=5
AUTH_IP_MAX_REQUESTS=30
AUTH_WINDOW_MINUTES=15
# Внешний адрес сайта (для редиректа после входа и проверки Origin), например https://mezon.modeus.cc
PUBLIC_BASE_URL=http://localhost:3000
# Google OAuth: Credentials -> OAuth client ID (Web application). Пусто = вход через Google выключен (503)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Должен совпадать с Authorized redirect URI в Google Cloud. Пусто = PUBLIC_BASE_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=
