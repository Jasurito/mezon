# Claude Code: personal overrides stay local
.claude/settings.local.json

# OS
.DS_Store

# Secrets: API keys live only in local .env
.env
.env.*
!.env.example

# graphify: share the graph outputs, keep local state (cache, manifest, machine paths) out of git
graphify-out/*
!graphify-out/graph.html
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
