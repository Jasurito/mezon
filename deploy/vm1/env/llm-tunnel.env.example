# /etc/mezon/llm-tunnel.env: where mezon-llm-tunnel.service connects. vast.ai may change the IP and SSH port when the
# instance is recreated: update GPU_HOST/GPU_PORT, rescan the host key (README), systemctl restart mezon-llm-tunnel.
GPU_HOST=77.48.24.239
GPU_PORT=43041
GPU_USER=root
# docker0 address on vm1 (ip -4 addr show docker0): reachable from containers as host.docker.internal, not public
TUNNEL_BIND=172.17.0.1
TUNNEL_PORT=11435
