# Appended to /etc/mezon/backend.env by bootstrap.sh (after DATABASE_URL). Docker --env-file format: no quotes.
# Empty ANTHROPIC_API_KEY = no-AI mode (mentor shows sources only, NPC scripted lines).
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL_MENTOR=claude-haiku-5-5
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MENTOR_TIMEOUT=20
LLM_FAST_TIMEOUT=4
LLM_MENTOR_EFFORT=medium
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDER=
CORS_ORIGINS=https://mezon.modeus.cc
RAG_MIN_SCORE=0.01
RAG_TOP_K=30
RAG_RRF_K=60
RAG_TITLE_SIMILARITY=0.6
RAG_MAX_SOURCES=8
RERANKER=none
