# Backend settings (backend/app/config.py). bootstrap.sh writes DATABASE_URL, MONGO_URL and MONGO_DB with generated
# passwords, then appends every key below that is still missing. Docker --env-file format: KEY=value, no quotes.
#
# Empty ANTHROPIC_API_KEY = no-AI mode (mentor shows sources only, NPCs use scripted lines). Put the real key only here
# on vm1 (never in git/CI), then: systemctl restart mezon-backend
ANTHROPIC_API_KEY=
# anthropic | ollama. Production uses Ollama on the GPU server through mezon-llm-tunnel.service:
#   LLM_PROVIDER=ollama  OLLAMA_URL=http://host.docker.internal:11435  OLLAMA_MODEL=qwen3:30b-a3b  OLLAMA_THINK=false  EMBEDDER=ollama-bge-m3
LLM_PROVIDER=anthropic
LLM_MODEL_MENTOR=claude-haiku-5-5
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MENTOR_TIMEOUT=20
LLM_FAST_TIMEOUT=4
LLM_MENTOR_EFFORT=medium
# only used when LLM_PROVIDER=ollama (Ollama on the host)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_MENTOR_TIMEOUT=60
OLLAMA_FAST_TIMEOUT=15
# false = отключить режим размышлений (нужно для qwen3); пусто = не передавать
OLLAMA_THINK=
# embedding model chosen by ingestion (docs/INGESTION.md); empty = keyword search only
EMBEDDER=
CORS_ORIGINS=https://mezon.modeus.cc
RAG_MIN_SCORE=0.01
RAG_TOP_K=30
RAG_RRF_K=60
RAG_TITLE_SIMILARITY=0.6
RAG_MAX_SOURCES=8
# Наставник: rules = классификация вопроса правилами без вызова LLM (быстрее), llm = быстрая модель.
# MENTOR_MAX_SOURCES = сколько статей уходит наставнику (RAG_MAX_SOURCES наставника не касается).
MENTOR_CLASSIFIER=rules
MENTOR_MAX_SOURCES=5
# none | llm (one extra fast-model call); empty RERANK_TIMEOUT = LLM_FAST_TIMEOUT
RERANKER=none
RERANK_CANDIDATES=15
RERANK_TIMEOUT=
STRICT_CITATIONS=true

# --- pre-generated character speech (backend/app/tts, docs/TTS.md). Audio lives in the RustFS bucket "mezon-audio"
# (deploy/vm1/storage). The backend reads the manifests over the "mezon" network at startup; browsers get the files
# from nginx /audio/. Empty AUDIO_PUBLIC_BASE_URL = audio off (text only).
AUDIO_PUBLIC_BASE_URL=https://mezon.modeus.cc/audio
AUDIO_MANIFEST_BASE_URL=http://mezon-storage:9000/mezon-audio

# --- accounts (backend/app/auth). Production values for https://mezon.modeus.cc behind nginx.
# External site address: post-login redirects, the Google redirect URI and the CSRF Origin check (POSTs from any
# other origin get 403 CSRF_FAILED). Must match the address users open.
PUBLIC_BASE_URL=https://mezon.modeus.cc
# Secure flag on the mezon_session cookie (https only). false only for local http development.
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
# The backend listens on 127.0.0.1 behind our nginx, which appends the client IP to X-Forwarded-For: trust it, so the
# rate limits count real clients instead of 127.0.0.1 (one bucket for everybody).
TRUST_PROXY_HEADERS=true
# Brute-force limits: failed logins per email and auth requests per IP in a window (minutes). The per-IP limit is
# higher than the code default (30) because the jury and the hackathon venue share one Wi-Fi NAT address.
AUTH_LOGIN_MAX_FAILS=5
AUTH_IP_MAX_REQUESTS=120
AUTH_WINDOW_MINUTES=15
# Google OAuth (Google Cloud -> Credentials -> OAuth client ID, Web application). Empty = Google sign-in off (503).
# Authorized redirect URI in Google Cloud: https://mezon.modeus.cc/api/auth/google/callback
# After setting them: systemctl restart mezon-backend, then NEXT_PUBLIC_GOOGLE_AUTH=true in frontend.build.env
# and sudo mezon-deploy frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# empty = PUBLIC_BASE_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=
