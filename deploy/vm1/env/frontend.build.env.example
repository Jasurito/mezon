# Build-time settings for the frontend image (read by mezon-deploy, copied to /etc/mezon/frontend.build.env).
# mock = demo backend inside the browser; live = real FastAPI under /api on the same origin
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_SHOW_SKETCHES=true
# live mode only: show "Continue with Google". Set true after GOOGLE_CLIENT_ID/SECRET are in /etc/mezon/backend.env
NEXT_PUBLIC_GOOGLE_AUTH=false
