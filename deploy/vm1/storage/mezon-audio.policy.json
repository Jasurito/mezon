{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadAudio",
      "Effect": "Allow",
      "Principal": {"AWS": ["*"]},
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::mezon-audio/scenarios/*",
        "arn:aws:s3:::mezon-audio/common/*"
      ]
    }
  ]
}
