# Mezon MongoDB 7 (backend history: session_history, user_activity). Data lives in the docker volume "mezon-mongodata".
# No host port: only containers on the "mezon" network can reach it. Auth is on (root user from /etc/mezon/mongo.env).
[Unit]
Description=Mezon history store (MongoDB 7)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker network create mezon
ExecStartPre=-/usr/bin/docker rm -f mezon-mongo
# cache capped at 256 MB: the VM has 3.7 GB shared with Postgres, backend and frontend
ExecStart=/usr/bin/docker run --rm --name mezon-mongo --network mezon \
  --env-file /etc/mezon/mongo.env \
  -v mezon-mongodata:/data/db \
  mongo:7 --wiredTigerCacheSizeGB 0.25
ExecStop=/usr/bin/docker stop -t 30 mezon-mongo
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
