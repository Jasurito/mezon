# Mezon FastAPI backend. Image "mezon-backend:latest" is built on this host by /usr/local/sbin/mezon-deploy.
# The container runs migrations + optional legal seed on start (backend/docker/entrypoint.sh).
[Unit]
Description=Mezon backend (FastAPI)
Requires=docker.service mezon-db.service
After=docker.service mezon-db.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker network create mezon
ExecStartPre=-/usr/bin/docker rm -f mezon-backend
# wait until Postgres accepts connections (up to 60 s)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do /usr/bin/docker exec mezon-db pg_isready -q -U postgres -h 127.0.0.1 >/dev/null 2>&1 && exit 0; sleep 1; done; echo "mezon-db not ready" >&2; exit 1'
ExecStart=/usr/bin/docker run --rm --name mezon-backend --network mezon \
  -p 127.0.0.1:8000:8000 \
  --env-file /etc/mezon/backend.env \
  -e SCENARIOS_DIR=/app/scenarios -e SEED_PATH=/seed/seed.sql.gz \
  -v /opt/mezon/src/scenarios:/app/scenarios:ro \
  -v /opt/mezon/src/legal_data:/seed:ro \
  --add-host host.docker.internal:host-gateway \
  mezon-backend:latest
ExecStop=/usr/bin/docker stop -t 20 mezon-backend
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
